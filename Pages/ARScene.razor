@page "/arscene"
@inject IJSRuntime JS

<h3>AR Scene</h3>

<canvas id="threeCanvas"></canvas>

@if (!isInARMode)
{
    <button class="ar-button enter-ar" @onclick="EnterAR">Enter AR</button>
}
else
{
    <button class="ar-button exit-ar" @onclick="ExitAR">Exit AR</button>
}

@code {
    private bool isInARMode = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initScene", "threeCanvas");
        }
    }

    private async Task EnterAR()
    {
        var success = await JS.InvokeAsync<bool>("enterAR");
        if (success)
        {
            isInARMode = true;
        }
    }

    private async Task ExitAR()
    {
        await JS.InvokeVoidAsync("exitAR");
        isInARMode = false;
    }
}

<style>
    canvas {
        width: 100% !important;
        height: 100vh !important;
        display: block;
    }

    .ar-button {
        position: absolute;
        padding: 12px 24px;
        font-size: 16px;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        z-index: 1000;
    }

    .enter-ar {
        top: max(20px, env(safe-area-inset-top));
        left: max(20px, env(safe-area-inset-left));
        background-color: #007bff;
    }

    .exit-ar {
        top: max(20px, env(safe-area-inset-top));
        right: max(20px, env(safe-area-inset-right));
        background-color: #dc3545;
    }
</style>